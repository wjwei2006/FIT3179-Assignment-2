{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#526673",
      "titleColor": "#526673",
      "domainColor": "#D8E3E6",
      "tickColor": "#D8E3E6",
      "gridColor": "#E8EFF0",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#415761",
      "titleColor": "#415761",
      "labelFontSize": 11
    },
    "title": {
      "color": "#112F3C",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#0B7777",
        "#E3A35D",
        "#44648B",
        "#9D78A1",
        "#5A9C79",
        "#D77974",
        "#8D8C64",
        "#65A5B5"
      ]
    }
  },
  "data": {
    "url": "data/registration_waffle_2025.csv"
  },
  "width": "container",
  "height": 340,
  "mark": {
    "type": "rect",
    "cornerRadius": 3,
    "stroke": "#ffffff",
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "sort": "ascending",
      "axis": null
    },
    "color": {
      "field": "registered",
      "type": "nominal",
      "scale": {
        "domain": [
          "Registered",
          "Not registered"
        ],
        "range": [
          "#0B7777",
          "#DCE6E7"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "registered",
        "title": "Registered (illustrated)"
      }
    ]
  }
}
