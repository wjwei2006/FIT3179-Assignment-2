{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#526673",
      "titleColor": "#526673",
      "domainColor": "#D8E3E6",
      "tickColor": "#D8E3E6",
      "gridColor": "#E8EFF0",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#415761",
      "titleColor": "#415761",
      "labelFontSize": 11
    },
    "title": {
      "color": "#112F3C",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#0B7777",
        "#E3A35D",
        "#44648B",
        "#9D78A1",
        "#5A9C79",
        "#D77974",
        "#8D8C64",
        "#65A5B5"
      ]
    }
  },
  "width": "container",
  "height": 430,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.min.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E4EEEE",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/state_2025.csv"
      },
      "mark": {
        "type": "circle",
        "fill": "#E6A86C",
        "stroke": "#112F3C",
        "strokeWidth": 1,
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "deceased_donors",
          "type": "quantitative",
          "scale": {
            "range": [
              70,
              1800
            ]
          },
          "legend": {
            "title": "Deceased donors"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "deceased_donors",
            "type": "quantitative",
            "title": "Donors 2025",
            "format": ","
          },
          {
            "field": "transplant_recipients",
            "type": "quantitative",
            "title": "Recipients 2025",
            "format": ","
          }
        ]
      }
    }
  ]
}
