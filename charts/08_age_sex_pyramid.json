{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#526673",
      "titleColor": "#526673",
      "domainColor": "#D8E3E6",
      "tickColor": "#D8E3E6",
      "gridColor": "#E8EFF0",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#415761",
      "titleColor": "#415761",
      "labelFontSize": 11
    },
    "title": {
      "color": "#112F3C",
      "fontSize": 15
    },
    "range": {
      "category": [
        "#0B7777",
        "#E3A35D",
        "#44648B",
        "#9D78A1",
        "#5A9C79",
        "#D77974",
        "#8D8C64",
        "#65A5B5"
      ]
    }
  },
  "data": {
    "url": "data/aodr_age_gender_aug_2026.csv"
  },
  "width": "container",
  "height": 330,
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "registered_records",
          "as": "records"
        }
      ],
      "groupby": [
        "age",
        "gender"
      ]
    },
    {
      "calculate": "datum.gender == 'Female' ? -datum.records : datum.records",
      "as": "signed"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 2
  },
  "encoding": {
    "x": {
      "field": "signed",
      "type": "quantitative",
      "axis": {
        "title": "Registered decision records (count)",
        "labelExpr": "abs(datum.value)/1000 + \"k\""
      }
    },
    "y": {
      "field": "age",
      "type": "ordinal",
      "sort": [
        "16–17",
        "18–24",
        "25–34",
        "35–44",
        "45–54",
        "55–64",
        "65+"
      ],
      "axis": {
        "title": "Age group"
      }
    },
    "color": {
      "field": "gender",
      "scale": {
        "domain": [
          "Female",
          "Male"
        ],
        "range": [
          "#0B7777",
          "#D99968"
        ]
      },
      "legend": {
        "title": null
      }
    },
    "tooltip": [
      {
        "field": "age",
        "title": "Age"
      },
      {
        "field": "gender",
        "title": "Sex"
      },
      {
        "field": "records",
        "type": "quantitative",
        "title": "Published records",
        "format": ","
      }
    ]
  }
}